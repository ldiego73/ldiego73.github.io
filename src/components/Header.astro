---
import { type Lang, t } from "../i18n/ui";
import Icon from "./Icon.astro";
import KhipuMark from "./KhipuMark.astro";

interface Props {
  lang: Lang;
  alternate: string;
}
const { lang, alternate } = Astro.props;
const base = `/${lang}/`;
type Link = { href: string; label: string; world?: boolean };
type Group = { id: string; label: string; items: Link[] };
/**
 * Six entries on desktop: two groups open as dropdowns, the rest are plain links. On the phone menu the groups are
 * flat: a small heading over their links, nothing to expand.
 */
const entries: Array<Link | Group> = [
  {
    id: "about",
    label: t(lang, "nav.about"),
    items: [
      { href: `${base}#story`, label: t(lang, "nav.story") },
      { href: `${base}#artifacts`, label: t(lang, "nav.artifacts") },
      { href: `${base}uses/`, label: t(lang, "nav.uses") },
      { href: `${base}cv/`, label: t(lang, "nav.cv") },
    ],
  },
  { href: `${base}projects/`, label: t(lang, "nav.projects") },
  { href: `${base}blog/`, label: t(lang, "nav.blog") },
  {
    id: "explore",
    label: t(lang, "nav.explore"),
    items: [
      { href: `${base}world/`, label: lang === "es" ? "Mundo" : "World", world: true },
      { href: `${base}arcade/`, label: t(lang, "nav.arcade") },
    ],
  },
  { href: `${base}services/`, label: t(lang, "nav.services") },
  { href: `${base}#contact`, label: t(lang, "nav.contact") },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) => current.startsWith(href) && !href.includes("#");
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={base} aria-label="Luis Diego">
      <KhipuMark />
      <span>LDIEGO73</span>
    </a>
    <nav class="nav" aria-label={t(lang, "nav.menu")} id="site-nav">
      <ul class="top">
        {
          entries.map((e) =>
            "items" in e ? (
              <li class="group" data-nav-group>
                <button
                  class:list={["group-btn", { active: e.items.some((i) => isCurrent(i.href)) }]}
                  type="button"
                  aria-expanded="false"
                  aria-controls={`nav-${e.id}`}
                >
                  {e.label}
                  <svg class="caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
                    <path d="M2.5 4.5 6 8l3.5-3.5" />
                  </svg>
                </button>
                <span class="group-label mono" aria-hidden="true">
                  {e.label}
                </span>
                <ul class="sub" id={`nav-${e.id}`}>
                  {e.items.map((i) => (
                    <li>
                      <a
                        href={i.href}
                        class:list={[{ "nav-world": i.world }]}
                        aria-current={isCurrent(i.href) ? "page" : undefined}
                      >
                        {i.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={e.href} aria-current={isCurrent(e.href) ? "page" : undefined}>
                  {e.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
    <div class="tools">
      <button class="tool search" type="button" data-cmdk aria-label={t(lang, "search.open")}>
        <Icon name="search" size={18} />
        <kbd class="mono" aria-hidden="true">⌘K</kbd>
      </button>
      <a
        class="tool lang"
        href={alternate}
        hreflang={lang === "es" ? "en" : "es"}
        lang={lang === "es" ? "en" : "es"}
        data-lang-switch
      >
        <span aria-hidden="true">{lang === "es" ? "EN" : "ES"}</span>
        <span class="sr-only">{t(lang, "lang.switch")}</span>
      </a>
      <button class="tool" type="button" data-theme-toggle aria-label={t(lang, "theme.toggle")}>
        <span class="if-dark"><Icon name="sun" size={18} /></span>
        <span class="if-light"><Icon name="moon" size={18} /></span>
      </button>
      <button class="tool menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
        <Icon name="menu" size={18} />
        <span class="sr-only">{t(lang, "nav.menu")}</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { rememberLang, switchTarget } from "../lib/lang-switch";
  import { prefetchWorld } from "../lib/prefetch-world";

  // Language switch: same page in the other language, same section; remember the choice.
  const langLink = document.querySelector<HTMLAnchorElement>("a[data-lang-switch]");
  langLink?.addEventListener("click", (e) => {
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
    e.preventDefault();
    rememberLang(langLink.hreflang);
    location.href = switchTarget(langLink.getAttribute("href") ?? "/");
  });
  // Warm the 3D world as soon as someone heads for it.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a[href$="/world/"]')) {
    const go = () => void prefetchWorld(a.href);
    a.addEventListener("pointerenter", go, { once: true });
    a.addEventListener("focus", go, { once: true });
    a.addEventListener("touchstart", go, { once: true, passive: true });
  }
  // On a phone (≈ no hover), the "⌘K" hint makes no sense: the button stays, the hint hides via CSS.
  if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
    for (const k of document.querySelectorAll(".search kbd")) k.textContent = "Ctrl K";
  }

  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === "dark" : !matchMedia("(prefers-color-scheme: light)").matches;
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* storage unavailable */
    }
  });
  const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu]");
  const nav = document.getElementById("site-nav");
  menuBtn?.addEventListener("click", () => {
    const open = menuBtn.getAttribute("aria-expanded") !== "true";
    menuBtn.setAttribute("aria-expanded", String(open));
    nav?.classList.toggle("open", open);
  });
  nav?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) {
      nav.classList.remove("open");
      menuBtn?.setAttribute("aria-expanded", "false");
      closeGroups();
    }
  });

  // Desktop dropdowns (disclosure pattern): click or Enter toggles, Esc closes and returns focus, a click outside or
  // focus leaving the group closes it, and a mouse hovering the group opens it. Below 1000px the groups are flat.
  const groups = [...document.querySelectorAll<HTMLElement>("[data-nav-group]")];
  const btnOf = (g: HTMLElement) => g.querySelector<HTMLButtonElement>(".group-btn");
  const setOpen = (g: HTMLElement, open: boolean) => btnOf(g)?.setAttribute("aria-expanded", String(open));
  function closeGroups(except?: HTMLElement) {
    for (const g of groups) if (g !== except) setOpen(g, false);
  }
  const desktop = matchMedia("(min-width: 1001px)");
  for (const g of groups) {
    const btn = btnOf(g);
    let leaveTimer = 0;
    // A mouse click right after hover opened the group keeps it open instead of toggling it shut.
    let hoverOpened = false;
    btn?.addEventListener("click", (e) => {
      if (hoverOpened && e.detail > 0) {
        hoverOpened = false;
        return;
      }
      const open = btn.getAttribute("aria-expanded") !== "true";
      closeGroups(g);
      setOpen(g, open);
    });
    g.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || btn?.getAttribute("aria-expanded") !== "true") return;
      setOpen(g, false);
      btn.focus();
    });
    g.addEventListener("focusout", (e) => {
      if (!g.contains(e.relatedTarget as Node | null)) setOpen(g, false);
    });
    g.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse" || !desktop.matches) return;
      clearTimeout(leaveTimer);
      closeGroups(g);
      hoverOpened = btn?.getAttribute("aria-expanded") !== "true";
      setOpen(g, true);
    });
    g.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse" || !desktop.matches) return;
      hoverOpened = false;
      leaveTimer = window.setTimeout(() => setOpen(g, false), 180);
    });
  }
  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest("[data-nav-group]")) closeGroups();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 62px;
  }
  .brand {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 800 1.02rem/1 var(--font-display);
    font-stretch: 125%;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .nav a,
  .group-btn {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.94rem;
    white-space: nowrap;
  }
  .nav a:hover,
  .nav a[aria-current="page"],
  .group-btn:hover,
  .group-btn.active,
  .group-btn[aria-expanded="true"] {
    color: var(--fg);
  }
  .group {
    position: relative;
  }
  .group-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    cursor: pointer;
  }
  .caret {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s var(--ease-out);
  }
  .group-btn[aria-expanded="true"] .caret {
    transform: rotate(180deg);
  }
  .group-label {
    display: none;
  }
  /* Dropdown panel: one of the few raised surfaces (DESIGN.md: surface + border + one soft shadow). The top padding
     bridges the gap under the button so the pointer can travel into the panel without closing it. */
  .nav .sub {
    display: none;
    position: absolute;
    top: 100%;
    left: -14px;
    padding-top: 12px;
    isolation: isolate;
  }
  .group-btn[aria-expanded="true"] + .group-label + .sub {
    display: block;
  }
  .sub::before {
    content: "";
    position: absolute;
    inset: 12px 0 0;
    z-index: -1;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.25);
  }
  .sub li {
    min-width: 180px;
  }
  .sub a {
    display: block;
    padding: 10px 16px;
  }
  .sub li:first-child a {
    padding-top: 14px;
  }
  .sub li:last-child a {
    padding-bottom: 14px;
  }
  .tool.search {
    grid-auto-flow: column;
    gap: 8px;
    padding-inline: 10px;
  }
  .search kbd {
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  @media (hover: none), (max-width: 1000px) {
    .search kbd {
      display: none;
    }
  }
  .tools {
    flex: none;
    display: flex;
    gap: 8px;
  }
  .tool {
    display: inline-grid;
    place-items: center;
    min-width: 38px;
    height: 38px;
    padding: 0 8px;
    border-radius: 4px;
    border: 1px solid var(--line);
    background: none;
    color: var(--fg);
    font: 600 0.74rem/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-decoration: none;
    cursor: pointer;
  }
  .tool:hover {
    border-color: var(--muted);
  }
  .menu-btn {
    display: none;
  }
  .nav-world::after {
    content: "3D";
    margin-left: 6px;
    padding: 2px 5px 1px;
    border-radius: 3px;
    font: 600 0.62rem/1 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--turq);
    border: 1px solid color-mix(in srgb, var(--turq) 45%, transparent);
    vertical-align: 2px;
  }
  .if-light {
    display: none;
  }
  :global(:root[data-theme="light"]) .if-dark {
    display: none;
  }
  :global(:root[data-theme="light"]) .if-light {
    display: inline;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .if-dark {
      display: none;
    }
    :global(:root:not([data-theme="dark"])) .if-light {
      display: inline;
    }
  }
  @media (max-width: 1000px) {
    .menu-btn {
      display: inline-grid;
    }
    .tools {
      margin-left: auto;
    }
    .nav {
      position: absolute;
      inset: 62px 0 auto 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      display: none;
    }
    .nav.open {
      display: block;
    }
    .nav .top {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 16px;
    }
    .nav a {
      display: block;
      padding: 12px 0;
      font-size: 1.1rem;
      border-bottom: 1px solid var(--line);
    }
    /* Phone menu: groups are flat, a small heading over their links laid out two per row. */
    .group-btn {
      display: none;
    }
    .group-label {
      display: block;
      padding: 16px 0 2px;
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .nav .sub,
    .group-btn[aria-expanded="true"] + .group-label + .sub {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 16px;
      padding: 0;
    }
    .sub::before {
      display: none;
    }
    .sub li {
      min-width: 0;
    }
    .sub a,
    .sub li:first-child a,
    .sub li:last-child a {
      padding: 12px 0;
    }
  }
</style>

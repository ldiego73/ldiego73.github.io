---
import { ARTIFACTS, stageById } from "../../data/career";
import { type Lang, t } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<section class="section artifacts" id="artifacts" aria-labelledby="art-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="art-title">{t(lang, "artifacts.title")}</h2>
      <p class="lede">{t(lang, "artifacts.lede")}</p>
    </div>
    <div class="layout">
      <div class="list" role="tablist" aria-label={t(lang, "artifacts.title")}>
        {
          ARTIFACTS.map((a, i) => (
            <button
              type="button"
              role="tab"
              class={`art dye-${a.dye}`}
              id={`tab-${a.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`panel-${a.id}`}
              tabindex={i === 0 ? 0 : -1}
              data-artifact={a.id}
            >
              <span class="swatch" aria-hidden="true" />
              <span class="name">{a.name[lang]}</span>
              <span class="mono count">×{a.uses.length}</span>
            </button>
          ))
        }
      </div>
      <div class="stage" data-khipu="artifacts" data-lang={lang}>
        <div class="tags" aria-hidden="true" data-tags></div>
        <div class="tip" role="status" data-tip hidden></div>
      </div>
      <div class="panels">
        {
          ARTIFACTS.map((a, i) => (
            <div
              class={`panel dye-${a.dye}`}
              role="tabpanel"
              id={`panel-${a.id}`}
              aria-labelledby={`tab-${a.id}`}
              hidden={i !== 0}
            >
              <p class="mono tech">{a.tech}</p>
              <p class="summary">{a.summary[lang]}</p>
              <ol class="uses">
                {a.uses.map((u) => {
                  const ref = stageById(u.stage);
                  return (
                    <li>
                      <span class="mono where">
                        {ref?.company.name} · {ref?.stage.start.slice(0, 4)}
                      </span>
                      <span>{u.text[lang]}</span>
                    </li>
                  );
                })}
              </ol>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initKhipuStage } from "../../lib/khipu/mount";

  const section = document.getElementById("artifacts");
  const stage = section?.querySelector<HTMLElement>('[data-khipu="artifacts"]');
  const tabs = [...(section?.querySelectorAll<HTMLButtonElement>("[data-artifact]") ?? [])];
  let current = tabs[0]?.dataset.artifact ?? null;
  const khipu = stage ? initKhipuStage(stage, "artifacts") : Promise.resolve(null);
  khipu.then((k) => k?.setArtifact(current));

  const select = (btn: HTMLButtonElement, focus = false) => {
    current = btn.dataset.artifact ?? null;
    for (const b of tabs) {
      const on = b === btn;
      b.setAttribute("aria-selected", String(on));
      b.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(b.getAttribute("aria-controls") ?? "");
      if (panel) panel.hidden = !on;
    }
    if (focus) btn.focus();
    khipu.then((k) => k?.setArtifact(current));
  };
  for (const [i, b] of tabs.entries()) {
    b.addEventListener("click", () => select(b));
    b.addEventListener("keydown", (e) => {
      const d = e.key === "ArrowDown" || e.key === "ArrowRight" ? 1 : e.key === "ArrowUp" || e.key === "ArrowLeft" ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      const next = tabs[(i + d + tabs.length) % tabs.length];
      if (next) select(next, true);
    });
  }
</script>

<style>
  .artifacts {
    background: var(--bg-deep);
    border-block: 1px solid var(--line);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    grid-template-areas: "list stage" "panel stage";
    gap: var(--space-3) var(--space-4);
    align-items: start;
  }
  .list {
    grid-area: list;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .art {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 14px 4px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--muted);
    font: 600 1rem/1.3 var(--font-body);
    text-align: left;
    cursor: pointer;
  }
  .art:hover {
    color: var(--fg);
  }
  .art[aria-selected="true"] {
    color: var(--fg);
  }
  .swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--dye);
  }
  .art[aria-selected="true"] .swatch {
    background: var(--dye);
  }
  .count {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .stage {
    grid-area: stage;
    position: relative;
    height: clamp(420px, 58vh, 600px);
    min-width: 0;
  }
  .stage :global(.khipu-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }
  .panels {
    grid-area: panel;
  }
  .tech {
    font-size: 0.76rem;
    color: var(--dye);
    margin-bottom: 10px;
  }
  .summary {
    font-size: var(--step-1);
    line-height: 1.45;
    margin-bottom: var(--space-3);
  }
  .uses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 0.94rem;
  }
  .uses li {
    display: grid;
    grid-template-columns: 9.5em minmax(0, 1fr);
    gap: 12px;
  }
  .where {
    color: var(--muted);
    font-size: 0.76rem;
    padding-top: 3px;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
      grid-template-areas: "list" "stage" "panel";
    }
    .stage {
      height: 400px;
    }
  }
</style>

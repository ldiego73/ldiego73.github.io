---
import { SITE } from "../../data/site";
import { type Lang, t } from "../../i18n/ui";
import Icon from "../Icon.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="copy">
    <h1 id="hero-title">
      {lang === "es" ? <>Cada nudo, un sistema <em>en producción.</em></> : <>Every knot, a system <em>in production.</em></>}
    </h1>
    <p class="lede">{t(lang, "hero.lede")}</p>
    <div class="btn-row">
      <a class="btn btn-primary" href={SITE.calendly} target="_blank" rel="noopener">
        <Icon name="calendar" />
        {t(lang, "hero.cta.book")}
      </a>
      <a class="btn" href="#resume">{t(lang, "hero.cta.cv")}</a>
    </div>
  </div>
  <div class="stage" data-khipu="hero" data-lang={lang}>
    <div class="tags" aria-hidden="true" data-tags></div>
    <div class="tip" role="status" data-tip hidden></div>
    <p class="hint mono">{t(lang, "hero.hint")}</p>
    <noscript><p class="hint mono">JavaScript off: the full story is below.</p></noscript>
  </div>
</section>

<script>
  import { initKhipuStage } from "../../lib/khipu/mount";
  for (const el of document.querySelectorAll<HTMLElement>('[data-khipu="hero"]')) initKhipuStage(el, "hero");
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-3);
    align-items: center;
    padding-block: var(--space-4) var(--space-3);
    min-height: min(760px, calc(100svh - 62px));
  }
  h1 {
    margin-bottom: var(--space-3);
  }
  h1 em {
    font-style: normal;
    color: var(--red);
  }
  .lede {
    margin-bottom: var(--space-4);
  }
  .stage {
    position: relative;
    height: clamp(440px, 64vh, 660px);
    min-width: 0;
  }
  .stage :global(.khipu-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: pan-y;
  }
  .hint {
    position: absolute;
    right: 0;
    bottom: 0;
    font-size: 0.72rem;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .stage {
      order: -1;
      height: 420px;
      margin-inline: calc(var(--gutter) * -0.5);
    }
  }
</style>

---
/** Root: pick the visitor's language, defaulting to Spanish. */
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Luis Diego</title>
    <link rel="canonical" href="https://ldiego73.github.io/es/" />
    <link rel="alternate" hreflang="es" href="https://ldiego73.github.io/es/" />
    <link rel="alternate" hreflang="en" href="https://ldiego73.github.io/en/" />
    <meta http-equiv="refresh" content="0; url=/es/" />
    <script is:inline>
      // A language picked with the site's switch wins; otherwise the browser's languages decide.
      let saved = null;
      try {
        saved = localStorage.getItem("lang");
      } catch {}
      const langs = navigator.languages || [navigator.language];
      const en = saved ? saved === "en" : langs.some((l) => /^en\b/i.test(l)) && !langs.some((l) => /^es\b/i.test(l));
      location.replace((en ? "/en/" : "/es/") + location.hash);
    </script>
  </head>
  <body>
    <a href="/es/">Español</a> · <a href="/en/">English</a>
  </body>
</html>

---
import { Font } from "astro:assets";
import Analytics from "../../components/Analytics.astro";
import "../../styles/tokens.css";
import { CERTIFICATIONS, COMPANIES, EDUCATION, SKILLS } from "../../data/career";
import { SITE } from "../../data/site";
import { fmtPeriod, LANGS, type Lang } from "../../i18n/ui";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const copy = {
  es: {
    title: "Engineering Manager | Principal Architect",
    profileH: "Perfil profesional",
    profile:
      "Gerente de ingeniería con más de una década de experiencia dirigiendo equipos de desarrollo de software y arquitectura de soluciones. Experto en transformación digital, incluida la implantación de arquitecturas escalables, la optimización de procesos de desarrollo y el liderazgo tecnológico de equipos de alto rendimiento.",
    expH: "Experiencia",
    eduH: "Educación",
    skillsH: "Habilidades técnicas",
    certsH: "Certificaciones",
    pdf: "Descargar PDF",
  },
  en: {
    title: "Engineering Manager | Principal Architect",
    profileH: "Professional profile",
    profile:
      "Engineering manager with more than a decade of experience leading software development teams and solution architecture. Expert in digital transformation, including scalable architecture rollouts, development process optimization, and technology leadership of high-performing teams.",
    expH: "Experience",
    eduH: "Education",
    skillsH: "Technical skills",
    certsH: "Certifications",
    pdf: "Download PDF",
  },
}[lang];
const stages = COMPANIES.flatMap((c) => c.stages.map((s) => ({ c, s }))).sort((a, b) =>
  b.s.start.localeCompare(a.s.start),
);
---
<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.name} · CV</title>
    <meta name="robots" content="noindex" />
    <meta property="og:title" content={`${SITE.name} · CV`} />
    <meta property="og:image" content={new URL(`/og/${lang}/cv.png`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <Analytics />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-archivo" />
    <Font cssVariable="--font-hanken" />
    <Font cssVariable="--font-jetbrains" />
  </head>
  <body>
    <main class="cv">
      <header>
        <div>
          <h1>{SITE.name}</h1>
          <p class="role">{copy.title}</p>
        </div>
        <ul class="contact">
          <li>{SITE.email}</li>
          <li>linkedin.com/in/ldiego73</li>
          <li>github.com/ldiego73</li>
          <li>ldiego73.github.io</li>
        </ul>
      </header>
      <section>
        <h2>{copy.profileH}</h2>
        <p>{copy.profile}</p>
      </section>
      <section>
        <h2>{copy.expH}</h2>
        {
          stages
            .filter(({ c }) => !c.education)
            .map(({ c, s }) => (
              <article>
                <div class="row">
                  <h3>
                    {s.role[lang]} · <span>{c.name}</span>
                  </h3>
                  <p class="when">
                    {fmtPeriod(lang, s.start, s.end)} · {s.place[lang]}
                  </p>
                </div>
                <p class="summary">{s.summary[lang]}</p>
                <ul>
                  {s.knots.map((k) => (
                    <li>{k.text[lang]}</li>
                  ))}
                </ul>
              </article>
            ))
        }
      </section>
      <div class="cols">
        <section>
          <h2>{copy.eduH}</h2>
          <ul class="plain">
            {
              EDUCATION.map((e) => (
                <li>
                  <b>{e.title[lang]}</b>
                  <span>
                    {e.school} · {e.years}
                  </span>
                </li>
              ))
            }
          </ul>
          <h2>{copy.certsH}</h2>
          <ul class="plain">
            {
              CERTIFICATIONS.map((c) => (
                <li>
                  <b>{c.name}</b>
                  <span>{c.years} · Credly</span>
                </li>
              ))
            }
          </ul>
        </section>
        <section>
          <h2>{copy.skillsH}</h2>
          <dl>
            {
              SKILLS.map((g) => (
                <>
                  <dt>{g.group[lang]}</dt>
                  <dd>{g.items.join(", ")}</dd>
                </>
              ))
            }
          </dl>
        </section>
      </div>
      <p class="print-hide"><a href={SITE.resume[lang]} download>{copy.pdf}</a></p>
    </main>
  </body>
</html>

<style>
  @page {
    size: A4;
    margin: 14mm 14mm 16mm;
  }
  body {
    margin: 0;
    background: var(--bg-deep);
    color: var(--fg);
    font: 400 10.5pt/1.45 var(--font-body);
  }
  .cv {
    max-width: 820px;
    margin: 24px auto;
    padding: 40px 48px;
    background: var(--surface);
  }
  header {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 2px solid var(--red);
    padding-bottom: 14px;
    margin-bottom: 16px;
  }
  h1 {
    margin: 0;
    font: 800 30pt/0.95 var(--font-display);
    font-stretch: 70%;
    text-transform: uppercase;
  }
  .role {
    margin: 6px 0 0;
    color: var(--red);
    font-weight: 600;
  }
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: right;
    font: 400 8.5pt/1.6 var(--font-mono);
    color: var(--muted);
  }
  h2 {
    font: 800 12pt/1 var(--font-display);
    font-stretch: 80%;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 18px 0 8px;
    color: var(--indigo);
  }
  p {
    margin: 0;
  }
  article {
    break-inside: avoid;
    margin-bottom: 12px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  h3 {
    margin: 0;
    font-size: 10.5pt;
  }
  h3 span {
    color: var(--muted);
    font-weight: 500;
  }
  .when {
    font: 400 8.5pt/1.4 var(--font-mono);
    color: var(--muted);
  }
  .summary {
    margin: 3px 0 4px;
    font-style: italic;
  }
  ul {
    margin: 0;
    padding-left: 16px;
  }
  li + li {
    margin-top: 2px;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    break-inside: avoid;
  }
  .plain {
    list-style: none;
    padding: 0;
  }
  .plain li {
    display: grid;
    margin-bottom: 6px;
  }
  .plain span {
    color: var(--muted);
    font-size: 9pt;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 12px;
    margin: 0;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
  }
  .print-hide {
    margin-top: 24px;
  }
  @media print {
    body {
      background: none;
    }
    .cv {
      margin: 0;
      padding: 0;
      max-width: none;
    }
    .print-hide {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .cv {
      margin: 0;
      padding: 24px 16px;
    }
    header,
    .cols {
      display: grid;
      grid-template-columns: 1fr;
    }
    .contact {
      text-align: left;
    }
  }
</style>

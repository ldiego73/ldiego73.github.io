---
import Icon from "../../../components/Icon.astro";
import { NEON } from "../../../games/core/neon";
import { CHULLO_AT } from "../../../games/core/store";
import { ACHIEVEMENTS, GAMES } from "../../../games/registry";
import { LANGS, type Lang, t } from "../../../i18n/ui";
import Base from "../../../layouts/Base.astro";
import { CATALOG } from "../../../lib/passport";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const groups = [
  { key: "original", label: t(lang, "arcade.originals") },
  { key: "classic", label: t(lang, "arcade.classics") },
] as const;
const mid = Math.floor(GAMES.length / 2);
const first = GAMES[mid]!;
const passportCopy = {
  title: { es: "Pasaporte del Qhapaq Ñan", en: "Qhapaq Ñan passport" },
  count: { es: "Pasaporte", en: "Passport" },
  stamps: { es: "sellos", en: "stamps" },
  explore: { es: "Recorrer el camino", en: "Explore the trail" },
  reward: { es: "Recompensa: cabinas de aguayo", en: "Reward: aguayo cabinets" },
};
const rewardCopy = {
  title: { es: "Recompensas cruzadas", en: "Cross rewards" },
  skin: { es: "Cabinas de aguayo", en: "Aguayo cabinets" },
  skinDesc: {
    es: "Tejido de aguayo en las cabinas y una marquesina de khipu. Se gana completando el pasaporte del mundo andino.",
    en: "Aguayo weaving on the cabinets and a khipu marquee. Earned by completing the Andean world passport.",
  },
  skinGroup: { es: "Estilo de las cabinas", en: "Cabinet style" },
  neon: { es: "Bloque", en: "Block" },
  aguayo: { es: "Aguayo", en: "Aguayo" },
  skinLocked: { es: "Bloqueado · completa el pasaporte", en: "Locked · complete the passport" },
  chullo: { es: "Chullo de hilo dorado", en: "Golden-thread chullo" },
  chulloDesc: {
    es: `Desbloquea ${CHULLO_AT} logros del arcade y tu viajero lo lucirá en el Qhapaq Ñan.`,
    en: `Unlock ${CHULLO_AT} arcade achievements and your traveler wears it on the Qhapaq Ñan.`,
  },
  chulloOn: { es: "Desbloqueado · ya lo llevas en el mundo", en: "Unlocked · you wear it in the world" },
  progress: { es: "logros", en: "achievements" },
};
---
<Base lang={lang} title={t(lang, "arcade.title")} description={t(lang, "arcade.lede")}>
  <div class="block-world">
    <section class="hall" data-hall data-state="loading" data-board={t(lang, "arcade.leaderboard")} aria-labelledby="arcade-h1">
      <div class="hall-stage" data-lobby aria-hidden="true"></div>
      <div class="hall-audio" data-hall-audio></div>
      <div class="hall-ui">
        <div class="hall-head">
          <h1 id="arcade-h1" class="hall-title">{t(lang, "arcade.title")}</h1>
          <p class="hall-msg hall-loading" role="status">{t(lang, "arcade.loading")}</p>
          <p class="hall-msg hall-nogl">{t(lang, "arcade.noWebgl")}</p>
        </div>
        <div class="caption" data-caption style={`--dye:${NEON[first.neon]}`}>
          <p class="cap-title" data-cap-title>{first.title[lang]}</p>
          <p class="cap-tag" data-cap-tag>{first.tagline[lang]}</p>
          <p class="cap-meta">
            <span class="cap-best">{t(lang, "arcade.best")} <b data-cap-best>0</b></span>
            <span class="cap-hint hint-key">{t(lang, "arcade.hint")}</span>
            <span class="cap-hint hint-touch">{t(lang, "arcade.hintTouch")}</span>
          </p>
        </div>
        <nav class="dial" aria-label={t(lang, "arcade.hall")}>
          <ul data-dial>
            {
              GAMES.map((g, i) => (
                <li style={`--dye:${NEON[g.neon]}`}>
                  <a
                    href={`/${lang}/arcade/${g.slug}/`}
                    data-i={i}
                    data-slug={g.slug}
                    data-title={g.title[lang]}
                    data-tag={g.tagline[lang]}
                    data-marquee={g.marquee}
                    data-color={NEON[g.neon]}
                    aria-current={i === mid ? "true" : undefined}
                  >
                    <span aria-hidden="true">{g.marquee}</span>
                    <span class="sr-only">{g.title[lang]}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </section>

    <div class="wrap below">
      <section class="games-sec" aria-labelledby="games-h">
        <div class="sec-head">
          <h2 id="games-h">{t(lang, "arcade.games")}</h2>
          <p class="lede">{t(lang, "arcade.lede")}</p>
        </div>
        {
          groups.map((g) => (
            <div class="group">
              <h3>{g.label}</h3>
              <ul class="tiles">
                {GAMES.filter((x) => x.kind === g.key).map((x) => (
                  <li style={`--dye:${NEON[x.neon]}`}>
                    <a href={`/${lang}/arcade/${x.slug}/`}>
                      <span class="tile-marquee" aria-hidden="true">
                        {x.marquee}
                      </span>
                      <span class="tile-body">
                        <span class="tile-title">{x.title[lang]}</span>
                        <span class="tile-tag">{x.tagline[lang]}</span>
                        <span class="tile-foot">
                          <span class="tile-best">
                            {t(lang, "arcade.best")} <b data-best={x.slug}>0</b>
                          </span>
                          <span class="tile-play">
                            <Icon name="play" size={16} /> {t(lang, "arcade.play")}
                          </span>
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <div class="records">
        <section class="board" aria-labelledby="lb-title">
          <h2 id="lb-title"><Icon name="trophy" /> {t(lang, "arcade.leaderboard")}</h2>
          <ol class="lb" data-leaderboard>
            {
              GAMES.map((g) => (
                <li data-game={g.slug} style={`--dye:${NEON[g.neon]}`}>
                  <span class="lb-name">{g.title[lang]}</span>
                  <b>0</b>
                </li>
              ))
            }
          </ol>
        </section>
        <section class="wall" aria-labelledby="ach-title">
          <h2 id="ach-title">
            {t(lang, "arcade.achievements")} <span class="count" data-ach-count>0/{ACHIEVEMENTS.length}</span>
          </h2>
          <div class="passport-strip" data-passport-strip>
            <strong>{passportCopy.title[lang]}</strong>
            <span data-passport-count>{passportCopy.count[lang]}: 0/{CATALOG.length} {passportCopy.stamps[lang]}</span>
            <span class="passport-reward" data-passport-reward hidden>{passportCopy.reward[lang]}</span>
            <a href={`/${lang}/world/`}>{passportCopy.explore[lang]} <Icon name="arrow" size={16} /></a>
          </div>
          <div class="rewards" aria-label={rewardCopy.title[lang]}>
            <div class="reward locked" data-reward="skin">
              <span class="reward-swatch reward-aguayo" aria-hidden="true"></span>
              <span class="reward-text">
                <b>{rewardCopy.skin[lang]}</b>
                <span>{rewardCopy.skinDesc[lang]}</span>
                <span class="reward-state" data-skin-note>{rewardCopy.skinLocked[lang]}</span>
              </span>
              <div class="skin-pick" role="radiogroup" aria-label={rewardCopy.skinGroup[lang]} data-skin-pick>
                <button type="button" role="radio" data-skin="neon" aria-checked="true">{rewardCopy.neon[lang]}</button>
                <button type="button" role="radio" data-skin="aguayo" aria-checked="false" disabled>
                  {rewardCopy.aguayo[lang]}
                </button>
              </div>
            </div>
            <div class="reward locked" data-reward="chullo">
              <span class="reward-swatch reward-chullo" aria-hidden="true"></span>
              <span class="reward-text">
                <b>{rewardCopy.chullo[lang]}</b>
                <span>{rewardCopy.chulloDesc[lang]}</span>
                <span class="reward-state" data-chullo-note data-on={rewardCopy.chulloOn[lang]} data-unit={rewardCopy.progress[lang]}>
                  0/{CHULLO_AT} {rewardCopy.progress[lang]}
                </span>
              </span>
            </div>
          </div>
          <ul class="ach">
            {
              ACHIEVEMENTS.map((a) => (
                <li data-ach={a.id} class="locked">
                  <span class="badge" aria-hidden="true">
                    <Icon name="lock" size={16} />
                    <Icon name="trophy" size={16} />
                  </span>
                  <span class="ach-text">
                    <b>{a.title[lang]}</b>
                    <span>{a.description[lang]}</span>
                  </span>
                  <span class="sr-only" data-state data-unlocked-label={t(lang, "arcade.unlocked")}>
                    {t(lang, "arcade.locked")}
                  </span>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>
  </div>
</Base>

<script>
  import { ACHIEVEMENTS, GAMES } from "../../../games/registry";
  import {
    activeSkin,
    arcadeUnlockedCount,
    CHULLO_AT,
    type CabinetSkin,
    evaluate,
    grantWorldPassport,
    leaderboard,
    load,
    save,
    setSkin,
    skinUnlocked,
  } from "../../../games/core/store";
  import { getMusic } from "../../../audio";
  import { ARCADE_TRACKS } from "../../../audio/tracks/arcade";
  import { mountAudioControl } from "../../../games/core/audio-control";
  import { loadPassport, mergedPassport, PASSPORT_KEY, passportComplete } from "../../../lib/passport";

  const state = load();
  // Cross reward: a complete world passport unlocks "Qhapaq Ñan walker" (and the aguayo skin) here too.
  if (passportComplete(loadPassport()) && grantWorldPassport(state)) {
    evaluate(
      state,
      ACHIEVEMENTS,
      GAMES.map((g) => g.slug),
    );
    save(state);
  }
  const lang = document.documentElement.lang === "en" ? "en" : "es";
  const updatePassportStrip = () => {
    const view = mergedPassport();
    const count = document.querySelector("[data-passport-count]");
    const copy = { es: { name: "Pasaporte", stamps: "sellos" }, en: { name: "Passport", stamps: "stamps" } };
    if (count) count.textContent = `${copy[lang].name}: ${view.worldCollected}/${view.worldTotal} ${copy[lang].stamps}`;
  };
  updatePassportStrip();
  window.addEventListener("pageshow", updatePassportStrip);
  window.addEventListener("storage", (event) => {
    if (event.key === PASSPORT_KEY || event.key === null) updatePassportStrip();
  });
  const nf = new Intl.NumberFormat(lang === "en" ? "en-US" : "es-PE");
  const best: Record<string, number> = {};
  for (const g of GAMES) best[g.slug] = state.games[g.slug]?.best ?? 0;

  // Scores and achievements (plain HTML, works without WebGL).
  for (const el of document.querySelectorAll<HTMLElement>("[data-best]")) el.textContent = nf.format(best[el.dataset.best ?? ""] ?? 0);
  const list = document.querySelector("[data-leaderboard]");
  if (list) {
    for (const r of leaderboard(state, GAMES.map((g) => g.slug))) {
      const li = list.querySelector<HTMLElement>(`[data-game="${r.game}"]`);
      if (!li) continue;
      const b = li.querySelector("b");
      if (b) b.textContent = nf.format(r.best);
      list.appendChild(li);
    }
  }
  let unlocked = 0;
  for (const li of document.querySelectorAll<HTMLElement>("[data-ach]")) {
    if (!state.unlocked[li.dataset.ach ?? ""]) continue;
    unlocked++;
    li.classList.remove("locked");
    const s = li.querySelector<HTMLElement>("[data-state]");
    if (s) s.textContent = s.dataset.unlockedLabel ?? "";
  }
  const count = document.querySelector("[data-ach-count]");
  if (count) count.textContent = `${unlocked}/${ACHIEVEMENTS.length}`;

  // Rewards: aguayo cabinet skin (selectable once unlocked) and the world's golden-thread chullo.
  const world = document.querySelector<HTMLElement>(".block-world");
  const skinBox = document.querySelector<HTMLElement>('[data-reward="skin"]');
  const skinButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-skin-pick] [data-skin]")];
  const paintSkin = () => {
    const skin = activeSkin(state);
    if (world) world.dataset.skin = skin;
    for (const b of skinButtons) b.setAttribute("aria-checked", String(b.dataset.skin === skin));
  };
  if (skinUnlocked(state)) {
    skinBox?.classList.remove("locked");
    const note = document.querySelector<HTMLElement>("[data-skin-note]");
    if (note) note.hidden = true;
    for (const b of skinButtons) b.disabled = false;
    document.querySelector<HTMLElement>("[data-passport-reward]")?.removeAttribute("hidden");
  }
  for (const b of skinButtons) {
    b.addEventListener("click", () => {
      setSkin(state, (b.dataset.skin ?? "neon") as CabinetSkin);
      save(state);
      paintSkin();
    });
  }
  // Arrow keys move the choice inside the radiogroup.
  document.querySelector("[data-skin-pick]")?.addEventListener("keydown", (e) => {
    const k = (e as KeyboardEvent).key;
    if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(k) || !skinUnlocked(state)) return;
    e.preventDefault();
    const i = skinButtons.indexOf(document.activeElement as HTMLButtonElement);
    const next = skinButtons[(Math.max(0, i) + 1) % skinButtons.length];
    next?.focus();
    next?.click();
  });
  paintSkin();
  const done = arcadeUnlockedCount(
    state,
    ACHIEVEMENTS.map((a) => a.id),
  );
  const chulloNote = document.querySelector<HTMLElement>("[data-chullo-note]");
  if (chulloNote) {
    if (done >= CHULLO_AT) {
      document.querySelector('[data-reward="chullo"]')?.classList.remove("locked");
      chulloNote.textContent = chulloNote.dataset.on ?? "";
    } else chulloNote.textContent = `${done}/${CHULLO_AT} ${chulloNote.dataset.unit ?? ""}`;
  }

  // Hall: dial links drive the caption and the 3D focus.
  const hall = document.querySelector<HTMLElement>("[data-hall]");
  const stageEl = document.querySelector<HTMLElement>("[data-lobby]");
  const dial = document.querySelector<HTMLElement>("[data-dial]");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-dial] a")];
  const cap = document.querySelector<HTMLElement>("[data-caption]");
  const capTitle = document.querySelector("[data-cap-title]");
  const capTag = document.querySelector("[data-cap-tag]");
  const capBest = document.querySelector("[data-cap-best]");
  let lobby: { focus(i: number): void; dispose(): void } | null = null;

  const show = (i: number) => {
    const a = links[i];
    if (!a) return;
    links.forEach((l, k) => (k === i ? l.setAttribute("aria-current", "true") : l.removeAttribute("aria-current")));
    cap?.style.setProperty("--dye", a.dataset.color ?? "");
    if (capTitle) capTitle.textContent = a.dataset.title ?? "";
    if (capTag) capTag.textContent = a.dataset.tag ?? "";
    if (capBest) capBest.textContent = nf.format(best[a.dataset.slug ?? ""] ?? 0);
    // Keep the active chip visible in the scrollable dial without moving the page.
    if (dial && dial.scrollWidth > dial.clientWidth) {
      dial.scrollTo({ left: a.offsetLeft - dial.clientWidth / 2 + a.offsetWidth / 2, behavior: "smooth" });
    }
  };
  show(links.findIndex((l) => l.getAttribute("aria-current") === "true"));

  dial?.addEventListener("focusin", (e) => {
    const i = links.indexOf(e.target as HTMLAnchorElement);
    if (i < 0) return;
    show(i);
    lobby?.focus(i);
  });
  dial?.addEventListener("keydown", (e) => {
    const i = links.indexOf(document.activeElement as HTMLAnchorElement);
    if (i < 0) return;
    const next =
      e.key === "ArrowRight" ? i + 1 : e.key === "ArrowLeft" ? i - 1 : e.key === "Home" ? 0 : e.key === "End" ? links.length - 1 : -2;
    if (next === -2) return;
    e.preventDefault();
    links[Math.max(0, Math.min(links.length - 1, next))]?.focus();
  });

  // Lobby music: starts after the first user gesture, fades out when leaving for a game.
  const audioSlot = document.querySelector<HTMLElement>("[data-hall-audio]");
  if (audioSlot) mountAudioControl(audioSlot);
  const music = getMusic();
  let lobbyOn = false;
  const startLobby = () => {
    if (lobbyOn) return;
    lobbyOn = true;
    removeEventListener("pointerdown", startLobby);
    removeEventListener("keydown", startLobby);
    try {
      const track = ARCADE_TRACKS.lobby;
      const ready = music.unlock();
      Promise.resolve(ready)
        .catch(() => {})
        .then(() => {
          if (track && lobbyOn) music.play(track, { intensity: 0.2 });
        });
    } catch {
      /* audio unavailable */
    }
  };
  addEventListener("pointerdown", startLobby, { passive: true });
  addEventListener("keydown", startLobby);
  addEventListener("pagehide", () => {
    lobbyOn = false;
    try {
      music.stop(500);
    } catch {
      /* ignore */
    }
  });

  const webgl = (() => {
    try {
      const c = document.createElement("canvas");
      return !!(c.getContext("webgl2") || c.getContext("webgl"));
    } catch {
      return false;
    }
  })();

  if (hall && stageEl) {
    if (!webgl) hall.dataset.state = "fallback";
    else {
      import("../../../arcade-lobby/lobby")
        .then(({ mountLobby }) => {
          const start = links.findIndex((l) => l.getAttribute("aria-current") === "true");
          lobby = mountLobby(stageEl, {
            lang,
            games: links.map((a) => ({
              slug: a.dataset.slug ?? "",
              marquee: a.dataset.marquee ?? "",
              title: a.dataset.title ?? "",
              color: a.dataset.color ?? "#56b6c9",
            })),
            best,
            boardTitle: hall.dataset.board ?? "HI-SCORES",
            reducedMotion: matchMedia("(prefers-reduced-motion: reduce)").matches,
            onFocus: show,
            onEnter: (i) => {
              const href = links[i]?.href;
              if (href) location.href = href;
            },
            onReady: () => (hall.dataset.state = "ready"),
          });
          lobby.focus(start);
        })
        .catch(() => (hall.dataset.state = "fallback"));
      addEventListener("pagehide", () => {
        lobby?.dispose();
        lobby = null;
      });
    }
  }
</script>

<style>
  .passport-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin: 0 0 18px;
    padding: 14px 0;
    border-block: 1px solid var(--grid);
    font-size: 0.85rem;
  }
  .passport-strip strong {
    color: var(--ink);
  }
  .passport-strip > span {
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .passport-strip a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--lime);
    text-underline-offset: 4px;
  }
  .passport-strip a:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 4px;
  }
  .passport-reward {
    color: var(--amber) !important;
  }
  .rewards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 10px;
    margin: 0 0 18px;
  }
  .reward {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    padding: 14px;
    border-radius: 2px;
    background: #2a2c35;
    border: 3px solid #121318;
    box-shadow: inset 0 -5px 0 #121318;
    font-size: 0.9rem;
  }
  .reward b {
    display: block;
    color: #efe9da;
    line-height: 1.25;
  }
  .reward-text {
    display: grid;
    gap: 4px;
  }
  .reward-text > span {
    color: var(--dim);
  }
  .reward-text > .reward-state {
    font: 500 0.78rem / 1.3 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--amber);
  }
  .reward.locked .reward-state {
    color: var(--dim);
  }
  .reward.locked {
    background: var(--void);
  }
  .reward-swatch {
    width: 40px;
    height: 40px;
    border-radius: 2px;
    border: 3px solid #121318;
  }
  /* Tiny aguayo weave and a golden chullo stripe as reward badges. */
  .reward-aguayo {
    background:
      linear-gradient(135deg, #e2a83c 25%, transparent 25%) -5px 0 / 10px 10px,
      linear-gradient(225deg, #e2a83c 25%, transparent 25%) -5px 0 / 10px 10px,
      linear-gradient(315deg, #2f7d5b 25%, transparent 25%) 0 0 / 10px 10px,
      linear-gradient(45deg, #2f7d5b 25%, transparent 25%) 0 0 / 10px 10px,
      #b8304f;
  }
  .reward-chullo {
    background: repeating-linear-gradient(0deg, #b8304f 0 6px, #f2c14e 6px 9px, #34418f 9px 14px, #f2c14e 14px 17px);
  }
  .reward.locked .reward-swatch {
    filter: grayscale(1) brightness(0.55);
  }
  .skin-pick {
    grid-column: 1 / -1;
    display: flex;
    gap: 0;
  }
  .skin-pick button {
    min-height: 44px;
    flex: 1;
    padding: 8px 12px;
    font: 700 0.78rem / 1 var(--font-arcade-stack);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--floor);
    border: 3px solid #121318;
    cursor: pointer;
  }
  .skin-pick button + button {
    border-left: 0;
  }
  .skin-pick button[aria-checked="true"] {
    background: var(--amber);
    color: var(--void);
  }
  .skin-pick button:disabled {
    cursor: not-allowed;
    color: var(--dim);
    background: var(--void);
  }
  /* Aguayo skin on the cabinet tiles: woven band under each marquee, khipu cords hanging from it. */
  .block-world[data-skin="aguayo"] .tile-marquee {
    position: relative;
    border-bottom: 0;
    padding-bottom: 20px;
    background:
      repeating-linear-gradient(60deg, #6b4423 0 4px, #c58b4a 4px 8px) left 0 bottom 10px / 100% 6px no-repeat,
      repeating-linear-gradient(
          90deg,
          #b8304f 0 3px,
          transparent 3px 12px,
          #e2a83c 12px 15px,
          transparent 15px 24px,
          #2f7d5b 24px 27px,
          transparent 27px 36px,
          #efe2c4 36px 39px,
          transparent 39px 48px
        )
        left 8px bottom 0 / 100% 10px no-repeat,
      var(--dye);
  }
  .block-world {
    --void: #16171d;
    --floor: #2a2c35;
    --grid: #3c3f4b;
    --ink: #efe9da;
    --dim: #9b97a3;
    --cyan: #56b6c9;
    --lime: #7fb24a;
    --amber: #e2a83c;
    --magenta: #c45a8a;
    --font-arcade-stack: var(--font-arcade, "Silkscreen"), "Arial Narrow", sans-serif;
